meta {
  name: POST Creer compte B
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/comptes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{userB}}",
    "motDePasse": "{{password}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("userBId", res.getBody().id);
}

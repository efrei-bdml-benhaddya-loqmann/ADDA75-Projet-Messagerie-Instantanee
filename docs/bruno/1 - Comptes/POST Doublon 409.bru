meta {
  name: POST Doublon 409
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/comptes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{userA}}",
    "motDePasse": "{{password}}"
  }
}

assert {
  res.status: eq 409
}

tests {
  test("Format d'erreur {detail, code}", function() {
    expect(res.getBody()).to.have.property("detail");
    expect(res.getBody()).to.have.property("code");
  });
}

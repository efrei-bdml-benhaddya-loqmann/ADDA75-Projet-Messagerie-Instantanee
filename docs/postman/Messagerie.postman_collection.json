{
  "info": {
    "name": "ADDA75 — Messagerie instantanée (REST)",
    "description": "Requêtes REST du projet avec tests automatisés. Lancer avec le Runner dans l'ordre. Le canal WebSocket se teste via New → WebSocket : ws://localhost:8000/ws/messages?token={{token}} (trames dans le README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Comptes (POST /api/comptes)",
      "item": [
        {
          "name": "Créer le compte A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Noms uniques : la collection peut être rejouée sans erreur 409",
                  "const suffix = Date.now().toString().slice(-6);",
                  "pm.collectionVariables.set(\"userA\", \"alice_\" + suffix);",
                  "pm.collectionVariables.set(\"userB\", \"bob_\" + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Renvoie id et username, jamais le mot de passe\", () => { pm.expect(b).to.have.keys(\"id\", \"username\"); });",
                  "pm.collectionVariables.set(\"userAId\", b.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/comptes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "comptes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userA}}\",\n  \"motDePasse\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Créer le compte B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"userBId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/comptes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "comptes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userB}}\",\n  \"motDePasse\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Doublon → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Format d'erreur {detail, code}\", () => { const b = pm.response.json(); pm.expect(b).to.have.property(\"detail\"); pm.expect(b).to.have.property(\"code\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/comptes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "comptes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userA}}\",\n  \"motDePasse\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Champs invalides → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Format d'erreur {detail, code}\", () => { const b = pm.response.json(); pm.expect(b).to.have.property(\"detail\"); pm.expect(b).to.have.property(\"code\"); });",
                  "pm.test(\"Détail par champ\", () => pm.expect(pm.response.json().erreurs).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/comptes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "comptes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"a\",\n  \"motDePasse\": \"\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentification (POST /api/auth/login)",
      "item": [
        {
          "name": "Login A → JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Jeton Bearer reçu\", () => { pm.expect(b.tokenType).to.eql(\"bearer\"); pm.expect(b.token.split(\".\")).to.have.length(3); });",
                  "pm.collectionVariables.set(\"token\", b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userA}}\",\n  \"motDePasse\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Mauvais mot de passe → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Format d'erreur {detail, code}\", () => { const b = pm.response.json(); pm.expect(b).to.have.property(\"detail\"); pm.expect(b).to.have.property(\"code\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userA}}\",\n  \"motDePasse\": \"faux-mot-de-passe\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "3. Utilisateurs (GET /api/utilisateurs)",
      "item": [
        {
          "name": "Sans jeton → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"En-tête WWW-Authenticate: Bearer\", () => pm.response.to.have.header(\"WWW-Authenticate\", \"Bearer\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/utilisateurs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "utilisateurs"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Liste avec présence",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const users = pm.response.json();",
                  "pm.test(\"Chaque utilisateur a id, username, connecte\", () => users.forEach(u => pm.expect(u).to.have.keys(\"id\", \"username\", \"connecte\")));",
                  "pm.test(\"Le compte B est listé\", () => pm.expect(users.map(u => u.id)).to.include(Number(pm.collectionVariables.get(\"userBId\"))));",
                  "pm.test(\"Temps de réponse < 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/utilisateurs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "utilisateurs"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Historique (GET /api/messages/{id})",
      "item": [
        {
          "name": "Historique avec B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tableau JSON (vide tant qu'aucun message n'a été envoyé en WebSocket)\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/{{userBId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "messages",
                "{{userBId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Utilisateur inconnu → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Format d'erreur {detail, code}\", () => { const b = pm.response.json(); pm.expect(b).to.have.property(\"detail\"); pm.expect(b).to.have.property(\"code\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "messages",
                "999999"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Jeton falsifié → 401",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.upsert({key: \"Authorization\", value: \"Bearer \" + pm.collectionVariables.get(\"token\") + \"x\"});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/{{userBId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "messages",
                "{{userBId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "password",
      "value": "secret123"
    },
    {
      "key": "userA",
      "value": ""
    },
    {
      "key": "userB",
      "value": ""
    },
    {
      "key": "userAId",
      "value": ""
    },
    {
      "key": "userBId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}